---
import Layout from "@/layouts/Layout.astro";
import QueueDashboard from "@/components/queue/QueueDashboard";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4 py-8">
    <div class="mx-auto w-full max-w-lg">
      <div class="mb-6 flex items-start justify-between gap-4">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Queue
          </h1>
          <p class="mt-1 text-sm text-blue-100/80">
            Signed in as <span class="font-semibold text-white">{user?.email}</span>
          </p>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>

      <QueueDashboard client:load />
    </div>
  </div>
</Layout>
